import gurobipy as gp
from gurobipy import GRB

def resolver_minlp_garver():
    # 1. PARAMETROS DEL SISTEMA (Base 100 MVA)
    # Despacho neto (PG - PL) en pu para los 6 nodos (índices 0 a 5)
    # Nodo 1: -30 MW, Nodo 2: -240 MW, Nodo 3: 125 MW, Nodo 4: -160 MW, Nodo 5: -240 MW, Nodo 6: 545 MW
    net_injection = [-0.30, -2.40, 1.25, -1.60, -2.40, 5.45] 
    
    # Líneas existentes: (origen, destino, reactancia_pu, capacidad_pu)
    existing_lines = [
        (0, 1, 0.5, 1.0), # 1-2 (Cap 100 MW = 1.0 pu)
        (0, 3, 0.6, 0.8), # 1-4 (Cap 80 MW = 0.8 pu)
        (0, 4, 0.2, 1.0), # 1-5
        (1, 2, 0.2, 1.0), # 2-3
        (1, 3, 0.4, 1.0), # 2-4
        (2, 4, 0.2, 1.0)  # 3-5
    ]
    
    # Corredores candidatos: (origen, destino, costo, n_max, reactancia_pu, capacidad_pu)
    candidate_corridors = [
        (5, 1, 150, 4, 0.30, 1.0),  # 6-2
        (5, 3, 150, 4, 0.30, 1.0),  # 6-4
        (5, 4, 305, 3, 0.61, 1.0),  # 6-5 (x65 = 0.61 pu)
        (2, 4, 100, 3, 0.20, 1.0)   # 3-5
    ]

    # 2. INICIALIZAR EL MODELO
    m = gp.Model("Garver_MINLP")
    
    # ¡IMPORTANTE! Habilitar la resolución de restricciones cuadráticas no convexas
    # Esto le permite a Gurobi manejar el producto bilineal (n_ij * theta) sin Big-M
    m.Params.NonConvex = 2 
    m.Params.OutputFlag = 1 # Mostrar log

    # 3. VARIABLES DE DECISIÓN
    # Ángulos de nodo en radianes (El nodo 5, índice 4, es el nodo de referencia)
    theta = m.addVars(6, lb=-GRB.INFINITY, ub=GRB.INFINITY, name="theta")
    theta[4].lb = 0
    theta[4].ub = 0

    # Variable Entera n_ij: número de nuevas líneas a instalar
    n = {}
    f_cand = {} # Flujo en corredores candidatos
    for i, j, cost, nmax, x, cap in candidate_corridors:
        n[i, j] = m.addVar(vtype=GRB.INTEGER, lb=0, ub=nmax, name=f"n_{i+1}_{j+1}")
        f_cand[i, j] = m.addVar(lb=-nmax*cap, ub=nmax*cap, name=f"f_cand_{i+1}_{j+1}")

    # Variable continua para el flujo de las líneas existentes
    f_ex = {}
    for i, j, x, cap in existing_lines:
        f_ex[i, j] = m.addVar(lb=-cap, ub=cap, name=f"f_ex_{i+1}_{j+1}")

    # 4. RESTRICCIONES DE RED
    # Flujos por las líneas existentes (Segunda Ley de Kirchhoff)
    for i, j, x, cap in existing_lines:
        m.addConstr(f_ex[i, j] == (1/x) * (theta[i] - theta[j]), name=f"kirchhoff_ex_{i+1}_{j+1}")

    # Flujos por las líneas candidatas con la NO LINEALIDAD n_ij * (theta_i - theta_j)
    for i, j, cost, nmax, x, cap in candidate_corridors:
        # Aquí ocurre la bilinealidad
        m.addConstr(f_cand[i, j] == n[i, j] * (1/x) * (theta[i] - theta[j]), name=f"kirchhoff_cand_{i+1}_{j+1}")
        
        # Límites de capacidad dependientes de cuántas líneas se instalen
        m.addConstr(f_cand[i, j] <= n[i, j] * cap, name=f"lim_sup_{i+1}_{j+1}")
        m.addConstr(f_cand[i, j] >= -n[i, j] * cap, name=f"lim_inf_{i+1}_{j+1}")

    # Balance Nodal (Primera Ley de Kirchhoff)
    for node in range(6):
        inflow = gp.quicksum(f_ex[i, j] for i, j, x, cap in existing_lines if j == node) + \
                 gp.quicksum(f_cand[i, j] for i, j, cost, nmax, x, cap in candidate_corridors if j == node)
        
        outflow = gp.quicksum(f_ex[i, j] for i, j, x, cap in existing_lines if i == node) + \
                  gp.quicksum(f_cand[i, j] for i, j, cost, nmax, x, cap in candidate_corridors if i == node)
        
        # Inyección Neta = Flujos salientes - Flujos entrantes
        m.addConstr(outflow - inflow == net_injection[node], name=f"balance_{node+1}")

    # 5. FUNCIÓN OBJETIVO (Minimizar el costo de inversión)
    obj = gp.quicksum(cost * n[i, j] for i, j, cost, nmax, x, cap in candidate_corridors)
    m.setObjective(obj, GRB.MINIMIZE)

    # 6. RESOLVER EL MODELO
    m.optimize()

    # 7. IMPRIMIR RESULTADOS
    if m.status == GRB.OPTIMAL:
        print("\n--- SOLUCIÓN ÓPTIMA ---")
        print(f"Costo Total de Inversión: {m.ObjVal} USD/pu\n")
        
        print("Líneas instaladas por corredor:")
        for i, j, cost, nmax, x, cap in candidate_corridors:
            print(f" Corredor {i+1}-{j+1}: {int(n[i, j].X)} línea(s)")
            
        print("\nÁngulos de barra (Radianes):")
        for node in range(6):
            print(f" Nodo {node+1}: {theta[node].X:.4f} rad")
    else:
        print("No se encontró solución óptima.")

if __name__ == "__main__":
    resolver_minlp_garver()