import gurobipy as gp
from gurobipy import GRB

def resolver_lp_garver_automatico():
    # 1. PARÁMETROS BASE DEL SISTEMA
    # Nodos: 1=0, 2=1, 3=2, 4=3, 5=4, 6=5
    net_injection = [-0.30, -2.40, 1.25, -1.60, -2.40, 5.45] 
    
    # Líneas inicialmente existentes (origen, destino, x_pu, cap_pu)
    existing_lines = [
        (0, 1, 0.4, 1.0),
        (0, 3, 0.6, 0.8),
        (0, 4, 0.2, 1.0),
        (1, 2, 0.2, 1.0),
        (1, 3, 0.4, 1.0),
        (2, 4, 0.2, 1.0)
    ]
    
    # Diccionario de corredores candidatos con sus propiedades eléctricas y financieras
    # Llave: (origen, destino) -> Valor: (costo, x_pu, cap_pu)
    candidates = {
        (5, 1): (150, 0.30, 1.0),  # 6-2
        (5, 3): (150, 0.30, 1.0),  # 6-4
        (5, 4): (305, 0.61, 1.0),  # 6-5
        (2, 4): (100, 0.20, 1.0)   # 3-5
    }
    
    # Rastrear cuántas líneas agregamos en cada corredor
    lineas_agregadas = {k: 0 for k in candidates.keys()}
    iteracion = 1
    
    print("="*50)
    print(" 🚀 INICIANDO ALGORITMO LP ITERATIVO DE GARVER")
    print("="*50)

    # BUCLE ITERATIVO
    while True:
        # Crear un nuevo modelo en cada iteración para actualizar las restricciones
        m = gp.Model(f"Garver_LP_Iter_{iteracion}")
        m.Params.OutputFlag = 0 # Silenciar el log interno de Gurobi para ver solo nuestro reporte
        
        # Variables: Ángulos
        theta = m.addVars(6, lb=-GRB.INFINITY, ub=GRB.INFINITY, name="theta")
        m.addConstr(theta[4] == 0, name="ref_angle") # Nodo 5 es la referencia
        
        # Variables: Flujos en líneas existentes (las originales + las que vayamos construyendo)
        f_ex = {}
        # Usamos enumerate para diferenciar líneas paralelas en el mismo corredor
        for idx, (i, j, x, cap) in enumerate(existing_lines):
            f_ex[idx] = m.addVar(lb=-cap, ub=cap, name=f"fex_{idx}_{i+1}_{j+1}")
            m.addConstr(f_ex[idx] == (1/x) * (theta[i] - theta[j]), name=f"kirchhoff_{idx}")
            
        # Variables: Flujos ficticios (transporte) en corredores candidatos
        pd_plus = {}
        pd_minus = {}
        for (i, j) in candidates.keys():
            pd_plus[i, j] = m.addVar(lb=0, ub=GRB.INFINITY, name=f"pd_plus_{i+1}_{j+1}")
            pd_minus[i, j] = m.addVar(lb=0, ub=GRB.INFINITY, name=f"pd_minus_{i+1}_{j+1}")
            
        # Balance Nodal
        for node in range(6):
            # Salidas y entradas reales
            out_ex = gp.quicksum(f_ex[idx] for idx, (i, j, x, cap) in enumerate(existing_lines) if i == node)
            in_ex = gp.quicksum(f_ex[idx] for idx, (i, j, x, cap) in enumerate(existing_lines) if j == node)
            
            # Salidas y entradas ficticias
            out_cand = gp.quicksum((pd_plus[i, j] - pd_minus[i, j]) for (i, j) in candidates.keys() if i == node)
            in_cand = gp.quicksum((pd_plus[i, j] - pd_minus[i, j]) for (i, j) in candidates.keys() if j == node)
            
            m.addConstr((out_ex + out_cand) - (in_ex + in_cand) == net_injection[node], name=f"bal_{node+1}")
            
        # Función Objetivo: Minimizar flujos ficticios penalizados por su costo
        obj = gp.quicksum(cost * (pd_plus[i, j] + pd_minus[i, j]) for (i, j), (cost, x, cap) in candidates.items())
        m.setObjective(obj, GRB.MINIMIZE)
        
        # Resolver
        m.optimize()
        
        # CONDICIÓN DE PARADA: Si el costo objetivo es virtualmente 0, ya no hay congestión
        if m.ObjVal < 1e-4:
            print(f"\n✅ ITERACIÓN {iteracion}: ¡ÓPTIMO ALCANZADO!")
            print("Costo Ficticio = 0. La red existente soporta la demanda total.")
            break
            
        # ANALIZAR RESULTADOS DE LA ITERACIÓN
        print(f"\n--- ITERACIÓN {iteracion} ---")
        print(f"Costo Objetivo (Penalización): {m.ObjVal:.2f}")
        
        max_flow = -1
        max_corr = None
        
        print("Flujos ficticios calculados:")
        for (i, j) in candidates.keys():
            flujo_neto = abs(pd_plus[i, j].X - pd_minus[i, j].X)
            if flujo_neto > 0.001:
                print(f"  ► Corredor {i+1}-{j+1}: {flujo_neto:.2f} pu")
            
            # Identificar el corredor MÁS congestionado
            if flujo_neto > max_flow:
                max_flow = flujo_neto
                max_corr = (i, j)
                
        # ACCIÓN: Convertir el corredor más congestionado en una línea real
        costo, x, cap = candidates[max_corr]
        existing_lines.append((max_corr[0], max_corr[1], x, cap))
        lineas_agregadas[max_corr] += 1
        
        print(f"⚡ ACCIÓN: Se construye una línea en el corredor {max_corr[0]+1}-{max_corr[1]+1} (flujo máximo de {max_flow:.2f} pu)")
        
        iteracion += 1

    # RESULTADO FINAL DEL PLAN DE EXPANSIÓN
    print("\n" + "="*50)
    print(" 🏆 RESUMEN DEL PLAN DE EXPANSIÓN (MÉTODO LP)")
    print("="*50)
    
    costo_total_real = 0
    for (i, j), (costo, x, cap) in candidates.items():
        num_lineas = lineas_agregadas[(i, j)]
        if num_lineas > 0:
            print(f"📍 Corredor {i+1}-{j+1}: {num_lineas} nueva(s) línea(s)")
            costo_total_real += num_lineas * costo
            
    print(f"\n💰 Costo Total de Inversión Real: {costo_total_real} pu")

if __name__ == "__main__":
    resolver_lp_garver_automatico()